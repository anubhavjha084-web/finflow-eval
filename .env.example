# Environment Variables for FinFlow-Eval Live API Mode (`python3 run_eval.py --mode api`)
# Copy this file to `.env` and fill in the API key(s) for the provider(s) you wish to evaluate.
# Never commit actual API keys to version control or include `.env` inside the submission ZIP.

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
